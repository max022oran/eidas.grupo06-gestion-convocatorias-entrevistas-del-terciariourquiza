@startuml
title Modelo Entidad-Relación - Sistema de Bolsa de Trabajo

' ======================================
' ENTIDADES
' ======================================

entity "Empresa" as Empresa {
* idEmpresa : Int <<PK>>
  nombre : String
  rubro : String
  email : String
  contraseña : String
}

entity "Usuario" as Usuario {
  * idUsuario : Int <<PK>>
  --
  nombre : String
  apellido : String
  email : String
  contraseña : String
  sexo : String
  tipoUsuario : String
  cv : String
}

entity "Convocatoria" as Convocatoria {
  * idConvocatoria : Int <<PK>>
  --
  * idEmpresa : Int <<FK>>
  titulo : String
  descripcion : String
  puesto : String
  ubicacion : String
  requisitos : String
  fechaInicio : Date
  fechaFin : Date
  estado : String
  modalidad : String
  linkExterno : String
}

entity "Postulacion" as Postulacion {
* idPostulacion : Int <<PK>>
  * idUsuario : Int <<FK>>
  * idConvocatoria : Int <<FK>>
  fecha : Date
  estado : String
  puntaje : Float
}

entity "Entrevista" as Entrevista {
  * idEntrevista : Int <<PK>>
  * idPostulacion : Int <<FK>>
  fechaHora : DateTime
  puntaje : Float
  estado : String
}

' ======================================
' RELACIONES Y CARDINALIDADES
' ======================================

Empresa "1" -- "0..*" Convocatoria : publica
Usuario "1" -- "0..*" Postulacion : realiza
Convocatoria "1" -- "0..*" Postulacion : recibe
Postulacion "1" -- "0..1" Entrevista : genera

@enduml
